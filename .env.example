# OpenWhisper runs fully offline by default; cloud STT keys are optional.
# Every variable below is optional.

# Streaming engine: 'nemotron-streaming' (default, recommended)
#                   'elevenlabs-v2'
#                   'cartesia-ink2'
#                   'moonshine-streaming'
#                   'auto'
# OPENWHISPER_TRANSCRIPTION_ENGINE=nemotron-streaming

# Cloud STT provider keys. Do not commit real keys.
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=

# Cloud STT safety controls.
# Stop a cloud recording after this much local silence. Set 0 to disable.
# OPENWHISPER_AUTO_STOP_SILENCE_MS=15000

# Raise a local desktop alert after this much estimated cumulative cloud audio.
# Set 0 to disable.
# OPENWHISPER_CLOUD_USAGE_ALERT_MS=300000

# Local VAD. WebRTC is preferred; RMS is the fallback.
# OPENWHISPER_VAD_MODE=webrtc
# OPENWHISPER_WEBRTC_VAD_AGGRESSIVENESS=2
# OPENWHISPER_VAD_RMS_THRESHOLD=500

# Override the Nemotron ONNX bundle directory (defaults to ./models/nemotron-streaming-en-0.6b-int8)
# NEMOTRON_MODEL_DIR=/abs/path/to/nemotron/bundle

# Number of CPU threads sherpa-onnx uses for the encoder (default 2)
# NEMOTRON_NUM_THREADS=4
