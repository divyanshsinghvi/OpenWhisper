{
  "name": "listen",
  "version": "1.0.0",
  "description": "System-wide voice-to-text overlay app",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run build:watch\" \"wait-on dist/main.js && electron .\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "package": "electron-builder"
  },
  "keywords": [
    "voice",
    "speech-to-text",
    "whisper",
    "dictation",
    "overlay"
  ],
  "author": "divyanshsinghvi <divyanshsinghvi@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.25",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "electron-localshortcut": "^3.2.1",
    "node-record-lpcm16": "^1.0.1"
  },
  "build": {
    "appId": "com.openwhisper.app",
    "productName": "OpenWhisper",
    "publish": null,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      { "from": "python", "to": "scripts" },
      { "from": "models/nemotron-streaming-en-0.6b-int8", "to": "models/nemotron-streaming-en-0.6b-int8" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": false,
        "NSMicrophoneUsageDescription": "OpenWhisper needs microphone access to transcribe your speech locally on-device.",
        "NSAppleEventsUsageDescription": "OpenWhisper uses AppleScript to type transcribed text and fire voice-command keystrokes into the focused app."
      },
      "extraResources": [
        { "from": "build/python", "to": "python" }
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "OpenWhisper ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "divyanshsinghvi <divyanshsinghvi@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
